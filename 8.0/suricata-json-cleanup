#!/usr/bin/env bash
set -euo pipefail

LOG_DIR="${SURICATA_LOG_DIR:-/var/log/suricata}"
KEEP_DAYS="${SURICATA_JSON_KEEP_DAYS:-7}"

latest_json="$(find "$LOG_DIR" -maxdepth 1 -type f -name 'eve.*.json' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)"

if [[ -n "$latest_json" ]]; then
    find "$LOG_DIR" -maxdepth 1 -type f -name 'eve.*.json' -mtime +"$KEEP_DAYS" ! -path "$latest_json" -delete
else
    find "$LOG_DIR" -maxdepth 1 -type f -name 'eve.*.json' -mtime +"$KEEP_DAYS" -delete
fi
